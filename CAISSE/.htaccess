<IfModule mod_authz_core.c>
    <FilesMatch "^(login_log\.txt|php\.ini|db\.php|.*\.sql|.*\.log)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^(login_log\.txt|php\.ini|db\.php|.*\.sql|.*\.log)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
