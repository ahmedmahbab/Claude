<IfModule mod_authz_core.c>
    <FilesMatch "^(login_log\\.txt|php\\.ini|db\\.php|.*\\.sql)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^(login_log\\.txt|php\\.ini|db\\.php|.*\\.sql)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>
